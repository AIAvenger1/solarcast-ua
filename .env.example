# Claude API key for the AI advisor (https://platform.claude.com). Without it the
# service still works: the weekly plan is then built by the rule-based fallback.
ANTHROPIC_API_KEY=
# On a public deployment: only requests carrying this code may use the paid model
# (others get the rule-based plan). Open the site once as https://<host>/#key=<code>.
SOLARCAST_ACCESS_TOKEN=
# set to "off" to skip the model entirely
SOLARCAST_AI=on
